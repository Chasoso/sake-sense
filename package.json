{
  "name": "sake-sense",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:semantic-bridge": "esbuild backend/semantic-bridge/src/handler.mjs --bundle --platform=node --target=node24 --format=cjs --outfile=backend/semantic-bridge/dist/index.js",
    "package:semantic-bridge": "node scripts/package-semantic-bridge.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:e2e:gesture-calibration": "playwright test tests/e2e/gesture-calibration.spec.ts",
    "ui:inventory": "playwright test tests/e2e/ui-inventory.spec.ts",
    "generate:pwa-icons": "python scripts/generate-pwa-icons.py",
    "test:coverage": "vitest run --coverage",
    "validate:dictionary": "node scripts/quality/validate-dictionary.mjs",
    "validate:sensory-expressions": "node scripts/quality/validate-sensory-expressions.mjs",
    "validate:sensory-support-cases": "node scripts/quality/validate-sensory-support-cases.mjs",
    "validate:sake-sample": "node scripts/quality/validate-sake-sample.mjs",
    "validate:domain-integrity": "node scripts/quality/validate-domain-integrity.mjs",
    "validate:pwa": "node scripts/quality/validate-pwa.mjs",
    "secret-scan": "node scripts/quality/secret-scan.mjs",
    "validate": "npm run format:check && npm run lint && npm run typecheck && npm run validate:dictionary && npm run validate:sensory-expressions && npm run validate:sensory-support-cases && npm run validate:sake-sample && npm run validate:domain-integrity && npm run validate:pwa && npm run test:coverage && npm run build && npm run secret-scan",
    "prepare": "node scripts/setup-hooks.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1000.0",
    "@mediapipe/tasks-vision": "^1.0.1",
    "lucide-react": "^1.45.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "@vitest/coverage-v8": "^4.1.11",
    "ajv": "^8.17.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "prettier": "3.6.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.42.0",
    "vite": "^7.1.3",
    "vitest": "^4.1.11"
  }
}
