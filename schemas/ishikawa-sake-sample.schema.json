{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["version", "status", "products"],
  "properties": {
    "version": { "const": "0.2.0" },
    "status": { "const": "curated-mvp" },
    "products": {
      "type": "array",
      "minItems": 32,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "breweryId",
          "breweryName",
          "region",
          "sourceUrl",
          "sourceName",
          "sourceType",
          "sourceReviewedAt",
          "descriptionSummary",
          "termReferences",
          "availabilityStatus",
          "imageSourcePageUrl",
          "imageUsageStatus",
          "provenanceNotes",
          "reviewNotes"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "name": { "type": "string", "minLength": 1 },
          "breweryId": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "breweryName": { "type": "string", "minLength": 1 },
          "region": { "type": "string", "minLength": 1 },
          "sourceUrl": { "type": "string", "format": "uri" },
          "sourceName": { "type": "string", "minLength": 1 },
          "sourceType": {
            "enum": [
              "official-product-page",
              "official-store",
              "association",
              "public",
              "industry-association",
              "supplemental-database"
            ]
          },
          "sourceReviewedAt": { "type": "string", "format": "date" },
          "descriptionSummary": { "type": "string", "minLength": 1, "maxLength": 240 },
          "termReferences": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["termId", "sourceWording", "evidenceStatus", "rationale", "sourceUrl"],
              "properties": {
                "termId": { "type": "string" },
                "sourceWording": { "type": "string", "minLength": 1 },
                "evidenceStatus": { "enum": ["direct", "accepted-variant", "weak", "rejected"] },
                "rationale": { "type": "string", "minLength": 1 },
                "sourceUrl": { "type": "string", "format": "uri" }
              },
              "additionalProperties": false
            }
          },
          "availabilityStatus": { "enum": ["regular", "seasonal", "discontinued", "unknown"] },
          "currentAvailabilityStatus": {
            "enum": ["confirmed", "unconfirmed", "unavailable"]
          },
          "imageSourcePageUrl": { "type": "string", "format": "uri" },
          "imageSourceUrl": { "type": "string", "format": "uri" },
          "imageUsageStatus": { "enum": ["allowed", "needs-review", "not-allowed", "unknown"] },
          "provenanceNotes": { "type": "string", "minLength": 1 },
          "reviewNotes": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false,
        "allOf": [
          {
            "if": { "properties": { "availabilityStatus": { "const": "seasonal" } } },
            "then": { "required": ["currentAvailabilityStatus"] }
          },
          {
            "if": {
              "properties": {
                "availabilityStatus": { "enum": ["discontinued", "unknown"] }
              }
            },
            "then": {
              "not": {
                "properties": { "currentAvailabilityStatus": { "const": "confirmed" } },
                "required": ["currentAvailabilityStatus"]
              }
            }
          }
        ]
      }
    }
  },
  "additionalProperties": false
}
