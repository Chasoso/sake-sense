{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["version", "status", "entries"],
  "properties": {
    "version": { "type": "string", "const": "0.1.0" },
    "status": { "type": "string", "const": "experimental" },
    "entries": {
      "type": "array",
      "minItems": 5,
      "maxItems": 10,
      "items": {
        "type": "object",
        "required": [
          "id",
          "displayTerm",
          "definitionSummary",
          "vocabularyStatus",
          "sourceCategory",
          "everydayLanguageCandidates",
          "provenance",
          "notes"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "displayTerm": { "type": "string", "minLength": 1 },
          "definitionSummary": { "type": "string", "minLength": 1 },
          "vocabularyStatus": {
            "type": "string",
            "enum": ["selectable", "reference-only", "legacy"]
          },
          "sourceCategory": {
            "type": "string",
            "enum": [
              "basic-taste",
              "mouthfeel-stimulus",
              "mouthfeel-texture",
              "aftertaste",
              "concentration-body"
            ]
          },
          "parentTermId": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "everydayLanguageCandidates": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["text", "status"],
              "properties": {
                "text": { "type": "string", "minLength": 1 },
                "status": {
                  "type": "string",
                  "enum": ["source-supported", "inferred-from-examples", "experimental"]
                }
              },
              "additionalProperties": false
            }
          },
          "provenance": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "sourceId",
                "sourceName",
                "sourceType",
                "url",
                "accessedOn",
                "transformationNote"
              ],
              "properties": {
                "sourceId": { "type": "string", "minLength": 1 },
                "sourceName": { "type": "string", "minLength": 1 },
                "sourceType": { "type": "string", "minLength": 1 },
                "url": { "type": "string", "format": "uri" },
                "accessedOn": { "type": "string", "format": "date" },
                "transformationNote": { "type": "string", "minLength": 1 }
              },
              "additionalProperties": false
            }
          },
          "notes": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
