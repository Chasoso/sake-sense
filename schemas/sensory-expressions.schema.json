{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["version", "status", "expressions"],
  "properties": {
    "version": { "const": "0.1.0" },
    "status": { "const": "experimental" },
    "expressions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "displayText",
          "interpretationNote",
          "expressionStatus",
          "termLinkStatus",
          "candidateTermIds",
          "represents",
          "doesNotRepresent",
          "provenanceType",
          "notes"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "displayText": { "type": "string", "minLength": 1 },
          "interpretationNote": { "type": "string", "minLength": 1 },
          "expressionStatus": {
            "enum": ["active", "experimental", "reference-only", "deprecated"]
          },
          "termLinkStatus": { "enum": ["approved", "candidate", "unmapped"] },
          "candidateTermIds": {
            "type": "array",
            "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" }
          },
          "represents": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "doesNotRepresent": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "provenanceType": { "type": "string", "minLength": 1 },
          "notes": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
